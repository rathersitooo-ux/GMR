{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gameroad.local/schema/cartridge-manifest.v1.json",
  "title": "GAMEROAD Cartridge Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "hostApi", "entry", "capabilities", "payloadDigest"],
  "properties": {
    "schemaVersion": { "const": "gameroad.cartridge-manifest.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "hostApi": { "const": "gameroad.cartridge-host.v1" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["recipe", "module", "external"] },
        "ref": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ui.surface",
          "input.pointer",
          "input.keyboard",
          "audio.playback",
          "storage.local",
          "gameroad.cards.read",
          "gameroad.activity.report"
        ]
      }
    },
    "payloadDigest": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": ["string", "null"], "maxLength": 240 }
      }
    }
  }
}
